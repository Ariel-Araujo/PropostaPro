# Variáveis de Ambiente (Exemplo)
# Copie este arquivo para .env.local para configurar variáveis locais

# URL da Aplicação (usado em produção)
# NEXT_PUBLIC_APP_URL=https://seu-dominio.com

# Configurações de API (se adicionar backend no futuro)
# NEXT_PUBLIC_API_URL=https://api.seu-dominio.com
# API_SECRET_KEY=sua-chave-secreta

# Analytics (se adicionar no futuro)
# NEXT_PUBLIC_GA_TRACKING_ID=UA-XXXXXXXXX-X

# Email Service (se adicionar envio de e-mail no futuro)
# EMAIL_SERVICE_API_KEY=sua-chave-api
# EMAIL_FROM=contato@propostapro.com
